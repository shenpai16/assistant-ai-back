<style>
    .chat-container {
        max-height: 500px;
        overflow-y: auto;
        padding: 20px;
        background: #f5f5f5;
        border-radius: 10px;
        font-family: Arial, sans-serif;
    }

    .message-row {
        display: flex;
        margin-bottom: 12px;
    }

    .message-user {
        margin-left: auto;
        background: #007bff;
        color: white;
        padding: 10px 14px;
        border-radius: 12px;
        max-width: 70%;
        white-space: pre-wrap;
    }

    .message-ai {
        margin-right: auto;
        background: #e9ecef;
        color: #333;
        padding: 10px 14px;
        border-radius: 12px;
        max-width: 70%;
        white-space: pre-wrap;
    }

    .message-date {
        font-size: 11px;
        color: #666;
        margin-top: 4px;
    }
</style>

<div class="chat-container">
    {% for message in field.value %}
        <div class="message-row">
            {% if message.role == 'user' %}
                <div>
                    <div class="message-user">{{ message.content }}</div>
                    <div class="message-date">{{ message.createdAt|date('d/m/Y H:i') }}</div>
                </div>
            {% else %}
                <div>
                    <div class="message-ai">{{ message.content }}</div>
                    <div class="message-date">{{ message.createdAt|date('d/m/Y H:i') }}</div>
                </div>
            {% endif %}
        </div>
    {% endfor %}
</div>