{% set error = app.session.get('security.authentication_error') %}
{% set last_username = app.session.get('security.last_username') %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Connexion</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap">
</head>

<body style="background:#f5f6fa; font-family: Inter, sans-serif;">

<div class="login-wrapper" style="
    max-width: 420px;
    margin: 80px auto;
    padding: 40px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    text-align: center;
">
    <div style="margin-bottom: 25px;">
        <img src="/images/logo_officiel_clean.svg" alt="Logo" style="height: 60px; margin-bottom: 10px;">
        <h2 style="font-weight: 600; font-size: 22px; margin: 0;">Espace sécurisé</h2>
        <p style="color: #666; font-size: 14px; margin-top: 6px;">
            Connectez-vous pour accéder à votre tableau de bord.
        </p>
    </div>

    {% if error %}
        <div style="background:#ffe5e5; color:#b30000; padding:12px; border-radius:8px; margin-bottom:20px;">
            Identifiants incorrects.
        </div>
    {% endif %}


    <form method="post" action="{{ path('app_login') }}" style="text-align: left;" enctype="application/x-www-form-urlencoded">
        <label for="inputEmail" style="font-size: 14px; font-weight: 500;">Adresse email</label>
        <input type="email" name="_email" id="inputEmail" value="{{ last_username }}" required autofocus
            style="
                width: 100%;
                padding: 12px;
                margin-top: 6px;
                margin-bottom: 18px;
                border-radius: 10px;
                border: 1px solid #ddd;
                font-size: 15px;
            "
        >

        <label for="inputPassword" style="font-size: 14px; font-weight: 500;">Mot de passe</label>
        <input type="password" name="_password" id="inputPassword" required
            style="
                width: 100%;
                padding: 12px;
                margin-top: 6px;
                margin-bottom: 25px;
                border-radius: 10px;
                border: 1px solid #ddd;
                font-size: 15px;
            "
        >
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" style="
            width: 100%;
            padding: 12px;
            background: #0066ff;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            color: white;
            cursor: pointer;
            transition: 0.2s;
        ">
            Se connecter
        </button>
    </form>

    <p style="margin-top: 25px; font-size: 13px; color: #999;">
        © {{ "now"|date("Y") }} Votre entreprise — Tous droits réservés
    </p>
</div>

</body>
</html>